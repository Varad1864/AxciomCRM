@model AcxiomCRM.Models.Activity
@{
    ViewData["Title"] = "Log Activity";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <a asp-action="Index" class="text-decoration-none small text-muted"><i class="fa-solid fa-arrow-left me-1"></i> Back to Activities</a>
                <h3 class="fw-bold mt-1 mb-0">Log Client Activity</h3>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4 p-md-5">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small py-2 mb-4"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="ActivityType" class="form-label fw-semibold">Activity Type <span class="text-danger">*</span></label>
                            <select asp-for="ActivityType" class="form-select">
                                <option value="Call">Call</option>
                                <option value="Meeting">Meeting</option>
                                <option value="Email">Email</option>
                                <option value="Task">Task</option>
                            </select>
                            <span asp-validation-for="ActivityType" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label fw-semibold">Status</label>
                            <select asp-for="Status" class="form-select">
                                <option value="Completed">Completed</option>
                                <option value="In Progress">In Progress</option>
                                <option value="Pending">Pending</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Subject" class="form-label fw-semibold">Subject / Title <span class="text-danger">*</span></label>
                            <input asp-for="Subject" class="form-control" placeholder="e.g. Sent revised technical RFP response" required />
                            <span asp-validation-for="Subject" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CustomerId" class="form-label fw-semibold">Customer Account</label>
                            <select asp-for="CustomerId" asp-items="ViewBag.CustomerId" class="form-select">
                                <option value="">-- Optional (If Customer) --</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="LeadId" class="form-label fw-semibold">Prospective Lead</label>
                            <select asp-for="LeadId" asp-items="ViewBag.LeadId" class="form-select">
                                <option value="">-- Optional (If Lead) --</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ActivityDate" class="form-label fw-semibold">Activity Date</label>
                            <input asp-for="ActivityDate" type="datetime-local" class="form-control" value="@DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm")" required />
                            <span asp-validation-for="ActivityDate" class="text-danger small"></span>
                        </div>

                        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                        {
                            <div class="col-md-6">
                                <label asp-for="AssignedTo" class="form-label fw-semibold">Representative</label>
                                <select asp-for="AssignedTo" asp-items="ViewBag.UsersList" class="form-select">
                                    <option value="">-- Current User --</option>
                                </select>
                            </div>
                        }

                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-semibold">Description / Notes</label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Summary of discussion, outcomes, or deliverables..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold">
                            <i class="fa-solid fa-check me-1"></i> Save Activity
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
