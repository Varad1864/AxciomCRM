@model IEnumerable<AcxiomCRM.Models.Lead>
@{
    ViewData["Title"] = "Lead Management";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1">Lead Management</h3>
        <p class="text-secondary mb-0">Capture prospective clients, qualify opportunities, and convert leads.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-primary rounded-pill px-3">
            <i class="fa-solid fa-plus me-1"></i> Capture Lead
        </a>
    </div>
</div>

<!-- Filters (Section 17.13) -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3 p-md-4">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                    <input type="text" name="search" value="@ViewBag.CurrentSearch" class="form-control border-start-0 ps-0" placeholder="Search lead name, company, email, phone..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="New" selected="@(ViewBag.CurrentStatus == "New")">New</option>
                    <option value="Contacted" selected="@(ViewBag.CurrentStatus == "Contacted")">Contacted</option>
                    <option value="Qualified" selected="@(ViewBag.CurrentStatus == "Qualified")">Qualified</option>
                    <option value="Unqualified" selected="@(ViewBag.CurrentStatus == "Unqualified")">Unqualified</option>
                    <option value="Converted" selected="@(ViewBag.CurrentStatus == "Converted")">Converted</option>
                    <option value="Lost" selected="@(ViewBag.CurrentStatus == "Lost")">Lost</option>
                </select>
            </div>
            <div class="col-md-3">
                <select name="source" class="form-select">
                    <option value="">All Sources</option>
                    <option value="Website" selected="@(ViewBag.CurrentSource == "Website")">Website</option>
                    <option value="Referral" selected="@(ViewBag.CurrentSource == "Referral")">Referral</option>
                    <option value="Cold Call" selected="@(ViewBag.CurrentSource == "Cold Call")">Cold Call</option>
                    <option value="Campaign" selected="@(ViewBag.CurrentSource == "Campaign")">Campaign</option>
                    <option value="Partner" selected="@(ViewBag.CurrentSource == "Partner")">Partner</option>
                    <option value="Other" selected="@(ViewBag.CurrentSource == "Other")">Other</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100 rounded-3">Filter</button>
            </div>
        </form>
    </div>
</div>

<!-- Leads Table -->
<div class="table-card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="fa-solid fa-filter-circle-dollar text-primary me-2"></i> Prospective Leads</span>
        <span class="badge bg-secondary">Total: @ViewBag.TotalCount</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small text-secondary">
                <tr>
                    <th>Code</th>
                    <th>Lead Name</th>
                    <th>Company</th>
                    <th>Contact</th>
                    <th>Source</th>
                    <th>Expected Value</th>
                    <th>Status</th>
                    <th>Assigned To</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody class="small">
                @if (Model.Any())
                {
                    @foreach (var l in Model)
                    {
                        <tr>
                            <td><span class="badge bg-light text-dark border">@l.LeadCode</span></td>
                            <td>
                                <a asp-action="Details" asp-route-id="@l.LeadId" class="fw-bold text-decoration-none">
                                    @l.LeadName
                                </a>
                                @if (l.Priority == "High")
                                {
                                    <span class="badge bg-danger-subtle text-danger ms-1" style="font-size: 0.68rem;">High Priority</span>
                                }
                            </td>
                            <td>@(l.CompanyName ?? "-")</td>
                            <td>
                                <div><i class="fa-solid fa-envelope text-muted me-1"></i> @l.Email</div>
                                <div><i class="fa-solid fa-phone text-muted me-1"></i> @l.Phone</div>
                            </td>
                            <td><span class="badge bg-light text-secondary border">@l.Source</span></td>
                            <td class="fw-bold text-success">@l.ExpectedValue.ToString("C0")</td>
                            <td>
                                @if (l.Status == "Converted")
                                {
                                    <span class="badge bg-success"><i class="fa-solid fa-check me-1"></i> Converted</span>
                                }
                                else if (l.Status == "Qualified")
                                {
                                    <span class="badge bg-primary">Qualified</span>
                                }
                                else if (l.Status == "Lost" || l.Status == "Unqualified")
                                {
                                    <span class="badge bg-secondary">@l.Status</span>
                                }
                                else
                                {
                                    <span class="badge bg-info text-dark">@l.Status</span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-primary-subtle text-primary border">
                                    <i class="fa-solid fa-user me-1"></i> @(l.AssignedUser?.FullName ?? "Unassigned")
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    @if (l.Status != "Converted")
                                    {
                                        <a asp-action="Convert" asp-route-id="@l.LeadId" class="btn btn-outline-success" title="Convert to Customer & Opportunity">
                                            <i class="fa-solid fa-wand-magic-sparkles me-1"></i> Convert
                                        </a>
                                    }
                                    <a asp-action="Details" asp-route-id="@l.LeadId" class="btn btn-outline-secondary" title="View Details">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@l.LeadId" class="btn btn-outline-primary" title="Edit Lead">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>
                                    <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteLeadModal-@l.LeadId" title="Delete Lead">
                                        <i class="fa-solid fa-trash-can"></i>
                                    </button>
                                </div>

                                <!-- Delete Modal -->
                                <div class="modal fade text-start" id="deleteLeadModal-@l.LeadId" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title fw-bold text-danger">Confirm Delete</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body">
                                                Are you sure you want to delete lead <strong>@l.LeadName</strong>?
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                                <form asp-action="Delete" asp-route-id="@l.LeadId" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-danger">Delete</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-filter-circle-xmark fs-2 mb-2 d-block text-secondary"></i>
                            No lead records found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (ViewBag.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
            <span class="small text-muted">Page @ViewBag.CurrentPage of @ViewBag.TotalPages</span>
            <ul class="pagination pagination-sm mb-0">
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" 
                           asp-route-page="@i" 
                           asp-route-search="@ViewBag.CurrentSearch" 
                           asp-route-status="@ViewBag.CurrentStatus" 
                           asp-route-source="@ViewBag.CurrentSource">@i</a>
                    </li>
                }
            </ul>
        </div>
    }
</div>
