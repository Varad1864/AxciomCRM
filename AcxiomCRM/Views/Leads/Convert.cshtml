@model AcxiomCRM.Models.ViewModels.LeadConvertViewModel
@{
    ViewData["Title"] = $"Convert Lead: {Model.LeadName}";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <a asp-action="Details" asp-route-id="@Model.LeadId" class="text-decoration-none small text-muted"><i class="fa-solid fa-arrow-left me-1"></i> Back to Lead</a>
                <h3 class="fw-bold mt-1 mb-0">Lead Conversion Workflow</h3>
                <p class="text-secondary mb-0">Convert qualified lead <strong>@Model.LeadName</strong> into an active Customer account and Sales Opportunity.</p>
            </div>
            <span class="badge bg-success-subtle text-success border px-3 py-2 rounded-pill"><i class="fa-solid fa-wand-magic-sparkles me-1"></i> CRM Conversion</span>
        </div>

        <form asp-action="Convert" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="LeadId" />
            <input type="hidden" asp-for="LeadCode" />
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="Phone" />
            <input type="hidden" asp-for="CompanyName" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small py-2 mb-4"></div>

            <!-- Card 1: Customer Account Creation -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-bottom p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="fw-bold fs-5 text-primary"><i class="fa-solid fa-building me-2"></i> 1. Customer Master Account</div>
                        <div class="form-check form-switch">
                            <input asp-for="CreateCustomer" class="form-check-input" id="toggleCustomer" />
                            <label class="form-check-label small fw-semibold" for="toggleCustomer">Create Customer Record</label>
                        </div>
                    </div>
                </div>
                <div class="card-body p-4" id="customerSection">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="CustomerCode" class="form-label fw-semibold">Customer Code</label>
                            <input asp-for="CustomerCode" class="form-control" readonly />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CustomerName" class="form-label fw-semibold">Customer / Account Name <span class="text-danger">*</span></label>
                            <input asp-for="CustomerName" class="form-control" required />
                            <span asp-validation-for="CustomerName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Email</label>
                            <input value="@Model.Email" class="form-control" readonly />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Phone</label>
                            <input value="@Model.Phone" class="form-control" readonly />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Card 2: Opportunity Creation -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-bottom p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="fw-bold fs-5 text-success"><i class="fa-solid fa-handshake me-2"></i> 2. Sales Opportunity</div>
                        <div class="form-check form-switch">
                            <input asp-for="CreateOpportunity" class="form-check-input" id="toggleOpp" />
                            <label class="form-check-label small fw-semibold" for="toggleOpp">Create Sales Opportunity</label>
                        </div>
                    </div>
                </div>
                <div class="card-body p-4" id="oppSection">
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="OpportunityName" class="form-label fw-semibold">Opportunity Name <span class="text-danger">*</span></label>
                            <input asp-for="OpportunityName" class="form-control" required />
                            <span asp-validation-for="OpportunityName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="OpportunityAmount" class="form-label fw-semibold">Estimated Amount ($) <span class="text-danger">*</span></label>
                            <input asp-for="OpportunityAmount" type="number" step="0.01" min="0.01" class="form-control" required />
                            <span asp-validation-for="OpportunityAmount" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="OpportunityProbability" class="form-label fw-semibold">Win Probability (%) <span class="text-danger">*</span></label>
                            <input asp-for="OpportunityProbability" type="number" min="0" max="100" class="form-control" required />
                            <span asp-validation-for="OpportunityProbability" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="OpportunityStage" class="form-label fw-semibold">Pipeline Stage</label>
                            <select asp-for="OpportunityStage" class="form-select">
                                <option value="Qualification">Qualification</option>
                                <option value="Proposal">Proposal</option>
                                <option value="Negotiation">Negotiation</option>
                                <option value="Won">Won</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="OpportunityCloseDate" class="form-label fw-semibold">Target Close Date <span class="text-danger">*</span></label>
                            <input asp-for="OpportunityCloseDate" type="date" class="form-control" required />
                            <span asp-validation-for="OpportunityCloseDate" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Owner Assignment -->
            @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
            {
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-body p-4">
                        <label asp-for="AssignedTo" class="form-label fw-semibold">Assign Converted Records To</label>
                        <select asp-for="AssignedTo" asp-items="ViewBag.UsersList" class="form-select">
                            <option value="">-- Keep Current Lead Owner --</option>
                        </select>
                    </div>
                </div>
            }

            <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                <a asp-action="Index" class="btn btn-light px-4">Cancel</a>
                <button type="submit" class="btn btn-success px-5 fw-semibold shadow-sm">
                    <i class="fa-solid fa-check-double me-2"></i> Finalize Conversion
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('toggleCustomer').addEventListener('change', function() {
            document.getElementById('customerSection').style.display = this.checked ? 'block' : 'none';
        });
        document.getElementById('toggleOpp').addEventListener('change', function() {
            document.getElementById('oppSection').style.display = this.checked ? 'block' : 'none';
        });
    </script>
}
