@model AcxiomCRM.Models.Lead
@{
    ViewData["Title"] = $"Lead Details - {Model.LeadName}";
    var followUps = (IEnumerable<AcxiomCRM.Models.FollowUp>)ViewBag.FollowUps;
    var activities = (IEnumerable<AcxiomCRM.Models.Activity>)ViewBag.Activities;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <a asp-action="Index" class="text-decoration-none small text-muted"><i class="fa-solid fa-arrow-left me-1"></i> Back to Leads</a>
        <h3 class="fw-bold mt-1 mb-0">@Model.LeadName</h3>
        <span class="text-secondary small">Code: @Model.LeadCode &bull; Captured: @Model.CreatedDate.ToString("MMM dd, yyyy")</span>
    </div>
    <div class="d-flex gap-2">
        @if (Model.Status != "Converted")
        {
            <a asp-action="Convert" asp-route-id="@Model.LeadId" class="btn btn-success rounded-pill px-3">
                <i class="fa-solid fa-wand-magic-sparkles me-1"></i> Convert to Customer & Opportunity
            </a>
        }
        else
        {
            <span class="badge bg-success-subtle text-success border px-3 py-2 rounded-pill align-self-center">
                <i class="fa-solid fa-check me-1"></i> Converted Lead
            </span>
        }
        <a asp-controller="FollowUps" asp-action="Create" asp-route-leadId="@Model.LeadId" class="btn btn-outline-primary rounded-pill">
            <i class="fa-solid fa-calendar-plus me-1"></i> Follow-Up
        </a>
        <a asp-action="Edit" asp-route-id="@Model.LeadId" class="btn btn-outline-secondary rounded-pill px-3">
            <i class="fa-solid fa-pen-to-square me-1"></i> Edit
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3"><i class="fa-solid fa-address-book text-primary me-2"></i> Lead Profile</h5>

                <div class="mb-3">
                    <span class="text-muted small d-block">Status</span>
                    <span class="badge @(Model.Status == "Converted" ? "bg-success" : (Model.Status == "Qualified" ? "bg-primary" : "bg-info text-dark"))">
                        @Model.Status
                    </span>
                </div>

                <div class="mb-3">
                    <span class="text-muted small d-block">Expected Value</span>
                    <span class="fw-bold fs-5 text-success">@Model.ExpectedValue.ToString("C0")</span>
                </div>

                <div class="mb-3">
                    <span class="text-muted small d-block">Email Address</span>
                    <span class="fw-semibold">@Model.Email</span>
                </div>

                <div class="mb-3">
                    <span class="text-muted small d-block">Phone</span>
                    <span class="fw-semibold">@Model.Phone</span>
                </div>

                <div class="mb-3">
                    <span class="text-muted small d-block">Company</span>
                    <span class="fw-semibold">@(Model.CompanyName ?? "Not Specified")</span>
                </div>

                <div class="mb-3">
                    <span class="text-muted small d-block">Source & Priority</span>
                    <span>@Model.Source &bull; <strong class="text-danger">@Model.Priority</strong></span>
                </div>

                <div>
                    <span class="text-muted small d-block">Assigned Representative</span>
                    <span class="badge bg-primary-subtle text-primary border">
                        <i class="fa-solid fa-user me-1"></i> @(Model.AssignedUser?.FullName ?? "Unassigned")
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <!-- Lead Follow-Ups -->
        <div class="table-card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="fa-solid fa-calendar-check text-primary me-2"></i> Lead Follow-Up Engagements</span>
                <a asp-controller="FollowUps" asp-action="Create" asp-route-leadId="@Model.LeadId" class="btn btn-sm btn-outline-primary rounded-pill">
                    <i class="fa-solid fa-plus me-1"></i> Add Follow-Up
                </a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 small">
                    <thead class="table-light">
                        <tr>
                            <th>Subject</th>
                            <th>Date</th>
                            <th>Type</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (followUps.Any())
                        {
                            @foreach (var f in followUps)
                            {
                                <tr>
                                    <td class="fw-semibold">@f.Subject</td>
                                    <td>@f.FollowUpDate.ToString("MMM dd, yyyy")</td>
                                    <td><span class="badge bg-light text-dark border">@f.FollowUpType</span></td>
                                    <td>
                                        <span class="badge @(f.Status == "Completed" ? "bg-success" : (f.Status == "Missed" ? "bg-danger" : "bg-warning text-dark"))">
                                            @f.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-3 text-muted">No scheduled follow-ups for this lead.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Touchpoints / Activities -->
        <div class="table-card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="fa-solid fa-clock-rotate-left text-info me-2"></i> Activity Log</span>
                <a asp-controller="Activities" asp-action="Create" asp-route-leadId="@Model.LeadId" class="btn btn-sm btn-outline-secondary rounded-pill">
                    <i class="fa-solid fa-plus me-1"></i> Log Touchpoint
                </a>
            </div>
            <div class="p-3">
                @if (activities.Any())
                {
                    @foreach (var a in activities)
                    {
                        <div class="p-3 mb-2 bg-light rounded-3 border-start border-3 border-primary">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="fw-bold small">@a.ActivityType: @a.Subject</span>
                                <span class="small text-muted">@a.ActivityDate.ToString("MMM dd, yyyy")</span>
                            </div>
                            <div class="small text-secondary mt-1">@(a.Description ?? "No description recorded.")</div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-3 text-muted small">No activity logged for this lead yet.</div>
                }
            </div>
        </div>
    </div>
</div>
