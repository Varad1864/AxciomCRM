@model IEnumerable<AcxiomCRM.Models.AuditLog>
@{
    ViewData["Title"] = "System Audit Trail";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1">Security & Business Audit Trail</h3>
        <p class="text-secondary mb-0">Immutable, append-oriented log tracking authentications, record modifications, and role changes.</p>
    </div>
    <span class="badge bg-secondary-subtle text-secondary border px-3 py-2 rounded-pill">
        <i class="fa-solid fa-lock text-success me-1"></i> Read-Only & Tamper-Proof
    </span>
</div>

<!-- Audit Filters (Section 4.9 & 17.16) -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3 p-md-4">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-3">
                <input type="text" name="searchUser" value="@ViewBag.SearchUser" class="form-control" placeholder="Search user or email..." />
            </div>
            <div class="col-md-2">
                <select name="actionFilter" class="form-select">
                    <option value="">All Actions</option>
                    <option value="Login" selected="@(ViewBag.CurrentAction == "Login")">Login</option>
                    <option value="Login Failed" selected="@(ViewBag.CurrentAction == "Login Failed")">Login Failed</option>
                    <option value="Logout" selected="@(ViewBag.CurrentAction == "Logout")">Logout</option>
                    <option value="Create" selected="@(ViewBag.CurrentAction == "Create")">Create</option>
                    <option value="Update" selected="@(ViewBag.CurrentAction == "Update")">Update</option>
                    <option value="Delete" selected="@(ViewBag.CurrentAction == "Delete")">Delete</option>
                    <option value="Role Change" selected="@(ViewBag.CurrentAction == "Role Change")">Role Change</option>
                    <option value="Lead Conversion" selected="@(ViewBag.CurrentAction == "Lead Conversion")">Lead Conversion</option>
                    <option value="Security" selected="@(ViewBag.CurrentAction == "Security")">Security</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="moduleFilter" class="form-select">
                    <option value="">All Modules</option>
                    <option value="Customer" selected="@(ViewBag.CurrentModule == "Customer")">Customer</option>
                    <option value="Lead" selected="@(ViewBag.CurrentModule == "Lead")">Lead</option>
                    <option value="Opportunity" selected="@(ViewBag.CurrentModule == "Opportunity")">Opportunity</option>
                    <option value="FollowUp" selected="@(ViewBag.CurrentModule == "FollowUp")">FollowUp</option>
                    <option value="User" selected="@(ViewBag.CurrentModule == "User")">User</option>
                    <option value="Auth" selected="@(ViewBag.CurrentModule == "Auth")">Auth / Security</option>
                </select>
            </div>
            <div class="col-md-3">
                <div class="input-group">
                    <input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control" title="From Date" />
                    <input type="date" name="toDate" value="@ViewBag.ToDate" class="form-control" title="To Date" />
                </div>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100 rounded-3">Filter Logs</button>
            </div>
        </form>
    </div>
</div>

<div class="table-card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="fa-solid fa-shield-halved text-primary me-2"></i> Audit Records</span>
        <span class="badge bg-secondary">Total: @ViewBag.TotalCount</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 small">
            <thead class="table-light text-secondary">
                <tr>
                    <th>Timestamp (UTC)</th>
                    <th>User</th>
                    <th>Action</th>
                    <th>Module</th>
                    <th>Record ID</th>
                    <th>Outcome / Result</th>
                    <th>Details / Metadata</th>
                    <th>IP Address</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var a in Model)
                    {
                        <tr>
                            <td class="text-nowrap text-muted"><i class="fa-solid fa-clock me-1"></i> @a.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td class="fw-bold">@(a.UserName ?? a.UserId ?? "System")</td>
                            <td>
                                @if (a.Action.Contains("Failed") || a.Action.Contains("Locked"))
                                {
                                    <span class="badge bg-danger">@a.Action</span>
                                }
                                else if (a.Action == "Create" || a.Action == "Lead Conversion")
                                {
                                    <span class="badge bg-success">@a.Action</span>
                                }
                                else if (a.Action == "Update" || a.Action == "Role Change")
                                {
                                    <span class="badge bg-info text-dark">@a.Action</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark border">@a.Action</span>
                                }
                            </td>
                            <td><span class="badge bg-primary-subtle text-primary border">@a.EntityName</span></td>
                            <td><code>@(a.RecordId ?? "-")</code></td>
                            <td>
                                <span class="badge @(a.Result == "Success" ? "bg-success-subtle text-success border" : "bg-danger-subtle text-danger border")">
                                    @(a.Result ?? "Success")
                                </span>
                            </td>
                            <td>
                                <div style="max-width: 300px; word-break: break-word;">
                                    @if (!string.IsNullOrEmpty(a.OldValue) || !string.IsNullOrEmpty(a.NewValue))
                                    {
                                        <div class="text-muted" style="font-size: 0.75rem;">
                                            @if (!string.IsNullOrEmpty(a.OldValue)) { <span>[Old: @a.OldValue] </span> }
                                            @if (!string.IsNullOrEmpty(a.NewValue)) { <span class="text-dark fw-semibold">[New: @a.NewValue]</span> }
                                        </div>
                                    }
                                    <span>@(a.Details ?? "-")</span>
                                </div>
                            </td>
                            <td class="text-muted">@(a.IpAddress ?? "127.0.0.1")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">No audit events match current criteria.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (ViewBag.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
            <span class="small text-muted">Page @ViewBag.CurrentPage of @ViewBag.TotalPages</span>
            <ul class="pagination pagination-sm mb-0">
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" 
                           asp-route-page="@i" 
                           asp-route-actionFilter="@ViewBag.CurrentAction" 
                           asp-route-moduleFilter="@ViewBag.CurrentModule" 
                           asp-route-searchUser="@ViewBag.SearchUser">@i</a>
                    </li>
                }
            </ul>
        </div>
    }
</div>
