@model AcxiomCRM.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Executive Sales Dashboard";
}

<!-- Dashboard Header & Date Filters -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1">
            Sales & Operations Dashboard
            @if (Model.UserRole == "SalesExecutive")
            {
                <span class="fs-6 text-primary fw-semibold ms-2">(My Assigned Pipeline)</span>
            }
            else if (Model.UserRole == "Manager")
            {
                <span class="fs-6 text-warning-emphasis fw-semibold ms-2">(Team Pipeline & Performance)</span>
            }
            else
            {
                <span class="fs-6 text-danger fw-semibold ms-2">(Enterprise Global Scope)</span>
            }
        </h3>
        <p class="text-secondary mb-0">Real-time CRM metrics, conversion tracking, and pipeline forecasting.</p>
    </div>

    <!-- Date Range Filter Buttons (Section 4.3) -->
    <div class="btn-group shadow-sm bg-white p-1 rounded-pill border" role="group">
        <a asp-action="Index" asp-route-dateFilter="Today" class="btn btn-sm rounded-pill px-3 @(Model.DateFilter.Equals("Today", StringComparison.OrdinalIgnoreCase) ? "btn-primary" : "btn-light text-secondary")">Today</a>
        <a asp-action="Index" asp-route-dateFilter="ThisWeek" class="btn btn-sm rounded-pill px-3 @(Model.DateFilter.Equals("ThisWeek", StringComparison.OrdinalIgnoreCase) ? "btn-primary" : "btn-light text-secondary")">This Week</a>
        <a asp-action="Index" asp-route-dateFilter="ThisMonth" class="btn btn-sm rounded-pill px-3 @(Model.DateFilter.Equals("ThisMonth", StringComparison.OrdinalIgnoreCase) ? "btn-primary" : "btn-light text-secondary")">This Month</a>
        <a asp-action="Index" asp-route-dateFilter="AllTime" class="btn btn-sm rounded-pill px-3 @(Model.DateFilter.Equals("AllTime", StringComparison.OrdinalIgnoreCase) ? "btn-primary" : "btn-light text-secondary")">All Time</a>
    </div>
</div>

<!-- Mandatory Dashboard KPI Cards (Section 17.11) -->
<div class="row g-3 mb-4">
    <!-- Total Customers -->
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <span class="text-secondary small fw-semibold text-uppercase">Total Customers</span>
                    <h3 class="fw-bold mt-2 mb-0">@Model.TotalCustomers</h3>
                    <small class="text-muted">Active client base</small>
                </div>
                <div class="p-3 bg-primary-subtle text-primary rounded-3">
                    <i class="fa-solid fa-users fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Total Leads & Open Leads -->
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <span class="text-secondary small fw-semibold text-uppercase">Total / Open Leads</span>
                    <h3 class="fw-bold mt-2 mb-0">@Model.TotalLeads <span class="fs-6 text-primary fw-medium">(@Model.OpenLeads Open)</span></h3>
                    <small class="text-muted">Prospective pipeline</small>
                </div>
                <div class="p-3 bg-info-subtle text-info-emphasis rounded-3">
                    <i class="fa-solid fa-filter-circle-dollar fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Total Pipeline Value -->
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <span class="text-secondary small fw-semibold text-uppercase">Total Pipeline Value</span>
                    <h3 class="fw-bold mt-2 mb-0 text-success">@Model.TotalPipelineValue.ToString("C0")</h3>
                    <small class="text-muted">Weighted: @Model.WeightedPipelineValue.ToString("C0")</small>
                </div>
                <div class="p-3 bg-success-subtle text-success rounded-3">
                    <i class="fa-solid fa-sack-dollar fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Won vs Lost Opportunities -->
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <span class="text-secondary small fw-semibold text-uppercase">Won / Lost Deals</span>
                    <h3 class="fw-bold mt-2 mb-0">
                        <span class="text-success">@Model.WonOpportunities W</span> / 
                        <span class="text-danger">@Model.LostOpportunities L</span>
                    </h3>
                    <small class="text-muted">Active: @Model.OpenOpportunities in progress</small>
                </div>
                <div class="p-3 bg-warning-subtle text-warning-emphasis rounded-3">
                    <i class="fa-solid fa-trophy fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Secondary KPI Row (Follow-ups & Team) -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="p-3 bg-white border rounded-3 d-flex align-items-center gap-3">
            <div class="bg-primary text-white rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                <i class="fa-solid fa-calendar-day"></i>
            </div>
            <div>
                <div class="small text-secondary fw-semibold">Pending Follow-Ups</div>
                <div class="fw-bold fs-5">@Model.PendingFollowUps</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="p-3 bg-white border rounded-3 d-flex align-items-center gap-3">
            <div class="bg-danger text-white rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                <i class="fa-solid fa-bell"></i>
            </div>
            <div>
                <div class="small text-secondary fw-semibold">Overdue Follow-Ups</div>
                <div class="fw-bold fs-5 text-danger">@Model.OverdueFollowUps</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="p-3 bg-white border rounded-3 d-flex align-items-center gap-3">
            <div class="bg-success text-white rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                <i class="fa-solid fa-user-shield"></i>
            </div>
            <div>
                <div class="small text-secondary fw-semibold">Active CRM Users</div>
                <div class="fw-bold fs-5">@Model.ActiveUsersCount</div>
            </div>
        </div>
    </div>
</div>

<!-- Chart.js Mandatory Visualizations (Section 17.12) -->
<div class="row g-4 mb-4">
    <!-- Chart 1: Lead Status Breakdown -->
    <div class="col-lg-4">
        <div class="table-card h-100 p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold mb-0"><i class="fa-solid fa-chart-pie text-primary me-2"></i> Lead Status Distribution</h6>
            </div>
            <div style="position: relative; height: 260px;">
                <canvas id="leadStatusChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Chart 2: Opportunity Pipeline Stage Breakdown -->
    <div class="col-lg-4">
        <div class="table-card h-100 p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold mb-0"><i class="fa-solid fa-chart-column text-success me-2"></i> Pipeline Stage Amounts ($)</h6>
            </div>
            <div style="position: relative; height: 260px;">
                <canvas id="pipelineStageChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Chart 3: Monthly Sales Trend -->
    <div class="col-lg-4">
        <div class="table-card h-100 p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold mb-0"><i class="fa-solid fa-chart-line text-warning me-2"></i> Closed Won Sales Trend</h6>
            </div>
            <div style="position: relative; height: 260px;">
                <canvas id="monthlySalesChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Actionable CRM Grids: Upcoming Follow-ups & Recent Opportunities -->
<div class="row g-4">
    <!-- Upcoming Follow-Ups -->
    <div class="col-lg-6">
        <div class="table-card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="fa-solid fa-clock text-primary me-2"></i> Upcoming Follow-Up Schedule</span>
                <a asp-controller="FollowUps" asp-action="Create" class="btn btn-sm btn-outline-primary rounded-pill">
                    <i class="fa-solid fa-plus me-1"></i> Schedule
                </a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small text-secondary">
                        <tr>
                            <th>Subject</th>
                            <th>Contact / Account</th>
                            <th>Due Date</th>
                            <th>Type</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody class="small">
                        @if (Model.UpcomingFollowUps.Any())
                        {
                            @foreach (var f in Model.UpcomingFollowUps)
                            {
                                <tr>
                                    <td class="fw-semibold">@f.Subject</td>
                                    <td>@(f.Customer?.CustomerName ?? f.Lead?.LeadName ?? "N/A")</td>
                                    <td>
                                        <span class="@(f.FollowUpDate < DateTime.UtcNow ? "text-danger fw-bold" : "text-muted")">
                                            @f.FollowUpDate.ToString("MMM dd, yyyy")
                                        </span>
                                    </td>
                                    <td><span class="badge bg-light text-dark border">@f.FollowUpType</span></td>
                                    <td>
                                        <span class="badge @(f.Status == "Completed" ? "bg-success" : (f.Status == "Missed" ? "bg-danger" : "bg-warning text-dark"))">
                                            @f.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">No pending follow-ups found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Recent Opportunities -->
    <div class="col-lg-6">
        <div class="table-card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="fa-solid fa-briefcase text-success me-2"></i> Recent Pipeline Opportunities</span>
                <a asp-controller="Opportunities" asp-action="Create" class="btn btn-sm btn-outline-success rounded-pill">
                    <i class="fa-solid fa-plus me-1"></i> New Deal
                </a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small text-secondary">
                        <tr>
                            <th>Opportunity</th>
                            <th>Stage</th>
                            <th>Amount</th>
                            <th>Probability</th>
                            <th>Close Date</th>
                        </tr>
                    </thead>
                    <tbody class="small">
                        @if (Model.RecentOpportunities.Any())
                        {
                            @foreach (var o in Model.RecentOpportunities)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@o.OpportunityId" class="text-decoration-none">
                                            @o.OpportunityName
                                        </a>
                                    </td>
                                    <td>
                                        <span class="badge @(o.Stage == "Won" ? "bg-success" : (o.Stage == "Lost" ? "bg-secondary" : "bg-primary-subtle text-primary border"))">
                                            @o.Stage
                                        </span>
                                    </td>
                                    <td class="fw-bold">@o.Amount.ToString("C0")</td>
                                    <td>@o.Probability%</td>
                                    <td class="text-muted">@o.ExpectedCloseDate.ToString("MMM dd, yyyy")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">No recent opportunities recorded.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Chart 1: Lead Status Doughnut Chart
        const leadLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadStatusLabels));
        const leadData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadStatusData));

        new Chart(document.getElementById('leadStatusChart'), {
            type: 'doughnut',
            data: {
                labels: leadLabels,
                datasets: [{
                    data: leadData,
                    backgroundColor: ['#3b82f6', '#06b6d4', '#10b981', '#10b981', '#ef4444'],
                    borderWidth: 2,
                    hoverOffset: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 11 } } }
                }
            }
        });

        // Chart 2: Opportunity Pipeline Stage Breakdown (Bar)
        const stageLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PipelineStageLabels));
        const stageAmounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PipelineStageAmounts));

        new Chart(document.getElementById('pipelineStageChart'), {
            type: 'bar',
            data: {
                labels: stageLabels,
                datasets: [{
                    label: 'Amount ($)',
                    data: stageAmounts,
                    backgroundColor: '#2563eb',
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) { return '$' + (value >= 1000 ? (value/1000) + 'k' : value); }
                        }
                    }
                },
                plugins: {
                    legend: { display: false }
                }
            }
        });

        // Chart 3: Monthly Sales / Won Totals (Line)
        const monthlyLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlySalesLabels));
        const monthlyValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlySalesValues));

        new Chart(document.getElementById('monthlySalesChart'), {
            type: 'line',
            data: {
                labels: monthlyLabels,
                datasets: [{
                    label: 'Won Value ($)',
                    data: monthlyValues,
                    borderColor: '#10b981',
                    backgroundColor: 'rgba(16, 185, 129, 0.15)',
                    fill: true,
                    tension: 0.35,
                    pointRadius: 4,
                    pointBackgroundColor: '#10b981'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) { return '$' + (value >= 1000 ? (value/1000) + 'k' : value); }
                        }
                    }
                },
                plugins: {
                    legend: { display: false }
                }
            }
        });
    </script>
}
