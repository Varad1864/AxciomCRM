@model AcxiomCRM.Models.Customer
@{
    ViewData["Title"] = $"Customer Details - {Model.CustomerName}";
    var opps = (IEnumerable<AcxiomCRM.Models.Opportunity>)ViewBag.Opportunities;
    var followUps = (IEnumerable<AcxiomCRM.Models.FollowUp>)ViewBag.FollowUps;
    var activities = (IEnumerable<AcxiomCRM.Models.Activity>)ViewBag.Activities;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <a asp-action="Index" class="text-decoration-none small text-muted"><i class="fa-solid fa-arrow-left me-1"></i> Back to Customers</a>
        <h3 class="fw-bold mt-1 mb-0">@Model.CustomerName</h3>
        <span class="text-secondary small">Code: @Model.CustomerCode &bull; Created: @Model.CreatedDate.ToString("MMM dd, yyyy")</span>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Opportunities" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-outline-success rounded-pill">
            <i class="fa-solid fa-plus me-1"></i> Add Opportunity
        </a>
        <a asp-controller="FollowUps" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-outline-primary rounded-pill">
            <i class="fa-solid fa-calendar-plus me-1"></i> Schedule Follow-Up
        </a>
        <a asp-action="Edit" asp-route-id="@Model.CustomerId" class="btn btn-primary rounded-pill px-3">
            <i class="fa-solid fa-pen-to-square me-1"></i> Edit
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: Master Data Profile -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3"><i class="fa-solid fa-id-card text-primary me-2"></i> Account Profile</h5>
                
                <div class="mb-3">
                    <span class="text-muted small d-block">Status</span>
                    <span class="badge-status @(Model.Status == "Active" ? "bg-success text-white" : "bg-secondary text-white")">
                        @Model.Status
                    </span>
                </div>

                <div class="mb-3">
                    <span class="text-muted small d-block">Email Address</span>
                    <span class="fw-semibold">@Model.Email</span>
                </div>

                <div class="mb-3">
                    <span class="text-muted small d-block">Phone Number</span>
                    <span class="fw-semibold">@Model.Phone</span>
                </div>

                <div class="mb-3">
                    <span class="text-muted small d-block">Company Name</span>
                    <span class="fw-semibold">@(Model.CompanyName ?? "Not Specified")</span>
                </div>

                <div class="mb-3">
                    <span class="text-muted small d-block">Location</span>
                    <span class="fw-semibold">@(string.Join(", ", new[] { Model.Address, Model.City, Model.State }.Where(s => !string.IsNullOrEmpty(s))))</span>
                </div>

                <div class="mb-3">
                    <span class="text-muted small d-block">Assigned Sales Executive</span>
                    <span class="badge bg-primary-subtle text-primary border">
                        <i class="fa-solid fa-user me-1"></i> @(Model.AssignedUser?.FullName ?? "Unassigned")
                    </span>
                </div>

                <div>
                    <span class="text-muted small d-block">Created By</span>
                    <span class="small text-secondary">@(Model.CreatedBy ?? "System")</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: Associated Pipeline, Follow-ups, Activities -->
    <div class="col-lg-8">
        <!-- Associated Opportunities -->
        <div class="table-card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="fa-solid fa-briefcase text-success me-2"></i> Associated Sales Opportunities</span>
                <span class="badge bg-success-subtle text-success">@opps.Count() Deals</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 small">
                    <thead class="table-light">
                        <tr>
                            <th>Opportunity</th>
                            <th>Stage</th>
                            <th>Amount</th>
                            <th>Probability</th>
                            <th>Expected Close</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (opps.Any())
                        {
                            @foreach (var o in opps)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@o.OpportunityId" class="text-decoration-none">
                                            @o.OpportunityName
                                        </a>
                                    </td>
                                    <td><span class="badge bg-light text-dark border">@o.Stage</span></td>
                                    <td class="fw-bold">@o.Amount.ToString("C0")</td>
                                    <td>@o.Probability%</td>
                                    <td>@o.ExpectedCloseDate.ToString("MMM dd, yyyy")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-3 text-muted">No opportunities registered under this customer.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Follow-Ups Schedule -->
        <div class="table-card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="fa-solid fa-calendar-check text-primary me-2"></i> Customer Follow-Ups</span>
                <span class="badge bg-primary-subtle text-primary">@followUps.Count() Items</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 small">
                    <thead class="table-light">
                        <tr>
                            <th>Subject</th>
                            <th>Date</th>
                            <th>Type</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (followUps.Any())
                        {
                            @foreach (var f in followUps)
                            {
                                <tr>
                                    <td class="fw-semibold">@f.Subject</td>
                                    <td>@f.FollowUpDate.ToString("MMM dd, yyyy")</td>
                                    <td><span class="badge bg-light text-dark border">@f.FollowUpType</span></td>
                                    <td>
                                        <span class="badge @(f.Status == "Completed" ? "bg-success" : (f.Status == "Missed" ? "bg-danger" : "bg-warning text-dark"))">
                                            @f.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-3 text-muted">No follow-ups scheduled.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Recent Activity Log -->
        <div class="table-card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="fa-solid fa-clock-rotate-left text-info me-2"></i> Touchpoints & Activities</span>
                <a asp-controller="Activities" asp-action="Create" asp-route-customerId="@Model.CustomerId" class="btn btn-sm btn-outline-secondary rounded-pill">
                    <i class="fa-solid fa-plus me-1"></i> Log Activity
                </a>
            </div>
            <div class="p-3">
                @if (activities.Any())
                {
                    <div class="timeline">
                        @foreach (var a in activities)
                        {
                            <div class="p-3 mb-2 bg-light rounded-3 border-start border-3 border-primary">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="fw-bold small"><i class="fa-solid fa-tag me-1 text-primary"></i> @a.ActivityType: @a.Subject</span>
                                    <span class="small text-muted">@a.ActivityDate.ToString("MMM dd, yyyy")</span>
                                </div>
                                <div class="small text-secondary mt-1">@(a.Description ?? "No description recorded.")</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-3 text-muted small">No touchpoints or activities recorded yet.</div>
                }
            </div>
        </div>
    </div>
</div>
