@model IEnumerable<AcxiomCRM.Models.Customer>
@{
    ViewData["Title"] = "Customers Master Data";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1">Customer Management</h3>
        <p class="text-secondary mb-0">Manage customer accounts, assigned relationships, and activity history.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Reports" asp-action="ExportCustomersCsv" class="btn btn-outline-secondary rounded-pill">
            <i class="fa-solid fa-file-csv me-1"></i> Export CSV
        </a>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-3">
            <i class="fa-solid fa-plus me-1"></i> New Customer
        </a>
    </div>
</div>

<!-- Search & Filter Card (Section 17.13) -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3 p-md-4">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                    <input type="text" name="search" value="@ViewBag.CurrentSearch" class="form-control border-start-0 ps-0" placeholder="Search by name, email, phone, company, or code..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="Active" selected="@(ViewBag.CurrentStatus == "Active")">Active</option>
                    <option value="Inactive" selected="@(ViewBag.CurrentStatus == "Inactive")">Inactive</option>
                    <option value="Prospect" selected="@(ViewBag.CurrentStatus == "Prospect")">Prospect</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100 rounded-3">
                    <i class="fa-solid fa-filter me-1"></i> Filter
                </button>
            </div>
            <div class="col-md-2">
                <a asp-action="Index" class="btn btn-light w-100 border rounded-3 text-secondary">
                    Reset
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Customer List Table -->
<div class="table-card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="fa-solid fa-building-user text-primary me-2"></i> All Registered Customers</span>
        <span class="badge bg-secondary">Total: @ViewBag.TotalCount</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small text-secondary">
                <tr>
                    <th>Code</th>
                    <th>Customer Name</th>
                    <th>Contact Info</th>
                    <th>Company</th>
                    <th>Assigned To</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody class="small">
                @if (Model.Any())
                {
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td><span class="badge bg-light text-dark border">@c.CustomerCode</span></td>
                            <td>
                                <a asp-action="Details" asp-route-id="@c.CustomerId" class="fw-bold text-decoration-none">
                                    @c.CustomerName
                                </a>
                                <div class="text-muted" style="font-size: 0.75rem;">Created @c.CreatedDate.ToString("MMM dd, yyyy")</div>
                            </td>
                            <td>
                                <div><i class="fa-solid fa-envelope text-muted me-1"></i> @c.Email</div>
                                <div><i class="fa-solid fa-phone text-muted me-1"></i> @c.Phone</div>
                            </td>
                            <td>@(c.CompanyName ?? "-")</td>
                            <td>
                                <span class="badge bg-primary-subtle text-primary border">
                                    <i class="fa-solid fa-user me-1"></i> @(c.AssignedUser?.FullName ?? "Unassigned")
                                </span>
                            </td>
                            <td>
                                <span class="badge-status @(c.Status == "Active" ? "bg-success text-white" : (c.Status == "Prospect" ? "bg-info text-white" : "bg-secondary text-white"))">
                                    @c.Status
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@c.CustomerId" class="btn btn-outline-secondary" title="View Details">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@c.CustomerId" class="btn btn-outline-primary" title="Edit Customer">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>
                                    <button type="button" class="btn btn-outline-danger" title="Delete or Deactivate" data-bs-toggle="modal" data-bs-target="#deleteModal-@c.CustomerId">
                                        <i class="fa-solid fa-trash-can"></i>
                                    </button>
                                </div>

                                <!-- Delete Confirmation Modal -->
                                <div class="modal fade text-start" id="deleteModal-@c.CustomerId" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title fw-bold text-danger"><i class="fa-solid fa-triangle-exclamation me-2"></i> Confirm Action</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                Are you sure you want to remove or deactivate customer <strong>@c.CustomerName</strong> (@c.CustomerCode)?
                                                <div class="mt-2 text-muted small">If this customer has active opportunities, the status will be safely switched to <em>Inactive</em> to preserve audit and transaction history.</div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                                <form asp-action="Delete" asp-route-id="@c.CustomerId" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-danger">Confirm Delete</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-user-xmark fs-2 mb-2 d-block text-secondary"></i>
                            No customer records match your filter criteria.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (ViewBag.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
            <span class="small text-muted">Page @ViewBag.CurrentPage of @ViewBag.TotalPages</span>
            <ul class="pagination pagination-sm mb-0">
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" 
                           asp-route-page="@i" 
                           asp-route-search="@ViewBag.CurrentSearch" 
                           asp-route-status="@ViewBag.CurrentStatus" 
                           asp-route-assignedTo="@ViewBag.CurrentAssignedTo">@i</a>
                    </li>
                }
            </ul>
        </div>
    }
</div>
