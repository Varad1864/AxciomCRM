@{
    ViewData["Title"] = "Access Denied";
    Layout = "_Layout";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="text-danger mb-4">
                <i class="fa-solid fa-shield-virus display-1"></i>
            </div>
            <h2 class="fw-bold text-danger">403 - Access Denied</h2>
            <p class="text-secondary mt-3">
                You do not have the required role or authorization to access this CRM resource or page. 
                Role-based access control (RBAC) has secured this endpoint.
            </p>
            <div class="mt-4">
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary px-4 py-2">
                    <i class="fa-solid fa-house me-2"></i> Return to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>
