@model AcxiomCRM.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Register User";
    Layout = "_Layout";
}

<div class="min-vh-100 d-flex align-items-center justify-content-center bg-light py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-7 col-lg-6">
                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-4 p-3 mb-3 shadow">
                        <i class="fa-solid fa-user-plus fs-1"></i>
                    </div>
                    <h2 class="fw-bold tracking-tight">Create CRM Account</h2>
                    <p class="text-muted">Register an authorized user with role privileges</p>
                </div>

                <div class="card shadow-lg border-0 rounded-4">
                    <div class="card-body p-4 p-sm-5">
                        <form asp-action="Register" method="post">
                            @Html.AntiForgeryToken()
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small py-2 mb-3" role="alert"></div>

                            <div class="mb-3">
                                <label asp-for="FullName" class="form-label fw-semibold">Full Name</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="fa-solid fa-user text-secondary"></i></span>
                                    <input asp-for="FullName" class="form-control" placeholder="e.g. John Doe" />
                                </div>
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Email" class="form-label fw-semibold">Email Address</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="fa-solid fa-envelope text-secondary"></i></span>
                                    <input asp-for="Email" class="form-control" placeholder="name@acxiom.com" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Role" class="form-label fw-semibold">Select Primary Role</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="fa-solid fa-id-badge text-secondary"></i></span>
                                    <select asp-for="Role" class="form-select">
                                        <option value="SalesExecutive">Sales Executive (Own / Assigned Records)</option>
                                        <option value="Manager">Manager (Team Management & Pipeline)</option>
                                        <option value="Admin">Admin (Full System Administration)</option>
                                    </select>
                                </div>
                                <span asp-validation-for="Role" class="text-danger small"></span>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Password" class="form-label fw-semibold">Password</label>
                                    <input asp-for="Password" class="form-control" placeholder="••••••••" />
                                    <span asp-validation-for="Password" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="ConfirmPassword" class="form-label fw-semibold">Confirm Password</label>
                                    <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••••" />
                                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="p-3 bg-light rounded-3 small text-muted mb-4 border">
                                <i class="fa-solid fa-circle-info text-primary me-1"></i>
                                Password must be at least 8 characters and include uppercase, lowercase, number, and special character (e.g. <code>Sales@123</code>).
                            </div>

                            <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold rounded-3 mb-3 shadow-sm">
                                <i class="fa-solid fa-user-check me-2"></i> Register Account
                            </button>

                            <div class="text-center text-secondary small">
                                Already registered? <a asp-action="Login" class="text-decoration-none fw-semibold">Sign In</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
