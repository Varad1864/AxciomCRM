@model AcxiomCRM.Models.ViewModels.UserEditViewModel
@{
    ViewData["Title"] = "Edit User";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <a asp-action="Index" class="text-decoration-none small text-muted"><i class="fa-solid fa-arrow-left me-1"></i> Back to Users</a>
                <h3 class="fw-bold mt-1 mb-0">Edit User Access & Roles</h3>
            </div>
            <span class="badge bg-danger-subtle text-danger border px-3 py-2 rounded-pill">Admin Management</span>
        </div>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4 p-md-5">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small py-2 mb-4"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold">Email / Username</label>
                        <input asp-for="Email" class="form-control" readonly />
                    </div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold">Full Name <span class="text-danger">*</span></label>
                        <input asp-for="FullName" class="form-control" required />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Role" class="form-label fw-semibold">Assigned Primary Role</label>
                        <select asp-for="Role" class="form-select">
                            <option value="SalesExecutive">Sales Executive</option>
                            <option value="Manager">Manager</option>
                            <option value="Admin">Administrator</option>
                        </select>
                        <span asp-validation-for="Role" class="text-danger small"></span>
                    </div>

                    <div class="p-3 bg-light rounded-3 mb-3 border">
                        <div class="form-check form-switch mb-2">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label fw-semibold">Active Account Status</label>
                        </div>
                        <small class="text-muted d-block">Deactivated users are blocked from signing in.</small>
                    </div>

                    <div class="p-3 bg-light rounded-3 mb-4 border">
                        <div class="form-check form-switch mb-2">
                            <input asp-for="UnlockAccount" class="form-check-input" />
                            <label asp-for="UnlockAccount" class="form-check-label fw-semibold text-danger">Unlock Account & Reset Failed Attempts</label>
                        </div>
                        <small class="text-muted d-block">If user was locked out due to repeated invalid password attempts, toggling this will clear the lockout.</small>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold">
                            <i class="fa-solid fa-floppy-disk me-1"></i> Update Access
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
