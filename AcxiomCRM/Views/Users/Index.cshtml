@model IEnumerable<AcxiomCRM.Models.ViewModels.UserItemViewModel>
@{
    ViewData["Title"] = "User & Role Management";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1">User & Role Administration</h3>
        <p class="text-secondary mb-0">Manage system users, assign roles (Admin, Manager, Sales Executive), and unlock accounts.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-primary rounded-pill px-3">
            <i class="fa-solid fa-user-plus me-1"></i> Add New User
        </a>
    </div>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3 p-md-4">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                    <input type="text" name="search" value="@ViewBag.CurrentSearch" class="form-control border-start-0 ps-0" placeholder="Search by name or email..." />
                </div>
            </div>
            <div class="col-md-4">
                <select name="roleFilter" class="form-select">
                    <option value="">All Roles</option>
                    <option value="Admin" selected="@(ViewBag.CurrentRole == "Admin")">Admin</option>
                    <option value="Manager" selected="@(ViewBag.CurrentRole == "Manager")">Manager</option>
                    <option value="SalesExecutive" selected="@(ViewBag.CurrentRole == "SalesExecutive")">Sales Executive</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100 rounded-3">Filter</button>
            </div>
        </form>
    </div>
</div>

<div class="table-card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="fa-solid fa-users-gear text-primary me-2"></i> Application Users & Access</span>
        <span class="badge bg-secondary">@Model.Count() Users</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small text-secondary">
                <tr>
                    <th>Full Name</th>
                    <th>Email / Username</th>
                    <th>Role</th>
                    <th>Account Status</th>
                    <th>Lockout Status</th>
                    <th>Created</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody class="small">
                @foreach (var u in Model)
                {
                    <tr>
                        <td class="fw-bold">@u.FullName</td>
                        <td>@u.Email</td>
                        <td>
                            @if (u.Role == "Admin")
                            {
                                <span class="role-badge role-admin">Admin</span>
                            }
                            else if (u.Role == "Manager")
                            {
                                <span class="role-badge role-manager">Manager</span>
                            }
                            else
                            {
                                <span class="role-badge role-sales">Sales Executive</span>
                            }
                        </td>
                        <td>
                            @if (u.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success border"><i class="fa-solid fa-circle-check me-1"></i> Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger border"><i class="fa-solid fa-circle-xmark me-1"></i> Inactive</span>
                            }
                        </td>
                        <td>
                            @if (u.IsLockedOut)
                            {
                                <span class="badge bg-danger"><i class="fa-solid fa-lock me-1"></i> Locked Out</span>
                            }
                            else
                            {
                                <span class="badge bg-light text-secondary border"><i class="fa-solid fa-lock-open me-1"></i> Normal</span>
                            }
                        </td>
                        <td class="text-muted">@u.CreatedDate.ToString("MMM dd, yyyy")</td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-outline-primary" title="Edit User & Roles">
                                    <i class="fa-solid fa-user-pen"></i> Edit
                                </a>
                                <a asp-action="ResetPassword" asp-route-id="@u.Id" class="btn btn-outline-warning text-dark" title="Reset Password">
                                    <i class="fa-solid fa-key"></i> Reset Pass
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
