@model IEnumerable<AcxiomCRM.Models.Opportunity>
@{
    ViewData["Title"] = "Sales Opportunities";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1">Opportunity Pipeline</h3>
        <p class="text-secondary mb-0">Track active deals, pipeline stages, win probabilities, and weighted forecasts.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Reports" asp-action="ExportOpportunitiesCsv" class="btn btn-outline-secondary rounded-pill">
            <i class="fa-solid fa-file-csv me-1"></i> Export CSV
        </a>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-3">
            <i class="fa-solid fa-plus me-1"></i> New Opportunity
        </a>
    </div>
</div>

<!-- Search & Stage Filters (Section 17.13) -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3 p-md-4">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                    <input type="text" name="search" value="@ViewBag.CurrentSearch" class="form-control border-start-0 ps-0" placeholder="Search opportunity name or client..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="stage" class="form-select">
                    <option value="">All Pipeline Stages</option>
                    <option value="Qualification" selected="@(ViewBag.CurrentStage == "Qualification")">Qualification</option>
                    <option value="Proposal" selected="@(ViewBag.CurrentStage == "Proposal")">Proposal</option>
                    <option value="Negotiation" selected="@(ViewBag.CurrentStage == "Negotiation")">Negotiation</option>
                    <option value="Won" selected="@(ViewBag.CurrentStage == "Won")">Closed Won</option>
                    <option value="Lost" selected="@(ViewBag.CurrentStage == "Lost")">Closed Lost</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="status" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="Open" selected="@(ViewBag.CurrentStatus == "Open")">Open</option>
                    <option value="Won" selected="@(ViewBag.CurrentStatus == "Won")">Won</option>
                    <option value="Lost" selected="@(ViewBag.CurrentStatus == "Lost")">Lost</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100 rounded-3">Filter</button>
            </div>
        </form>
    </div>
</div>

<!-- Opportunities Table -->
<div class="table-card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="fa-solid fa-handshake text-success me-2"></i> Deal Pipeline</span>
        <span class="badge bg-secondary">Total: @ViewBag.TotalCount</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small text-secondary">
                <tr>
                    <th>Opportunity Name</th>
                    <th>Account / Client</th>
                    <th>Deal Value</th>
                    <th>Stage</th>
                    <th>Probability</th>
                    <th>Weighted Value</th>
                    <th>Close Date</th>
                    <th>Owner</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody class="small">
                @if (Model.Any())
                {
                    @foreach (var o in Model)
                    {
                        <tr>
                            <td>
                                <a asp-action="Details" asp-route-id="@o.OpportunityId" class="fw-bold text-decoration-none">
                                    @o.OpportunityName
                                </a>
                            </td>
                            <td>@(o.Customer?.CustomerName ?? o.Lead?.LeadName ?? "Unlinked")</td>
                            <td class="fw-bold text-dark">@o.Amount.ToString("C0")</td>
                            <td>
                                <span class="badge @(o.Stage == "Won" ? "bg-success" : (o.Stage == "Lost" ? "bg-secondary" : "bg-primary-subtle text-primary border"))">
                                    @o.Stage
                                </span>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress flex-grow-1" style="height: 6px; width: 45px;">
                                        <div class="progress-bar @(o.Probability >= 70 ? "bg-success" : (o.Probability >= 40 ? "bg-primary" : "bg-warning"))" style="width: @o.Probability%"></div>
                                    </div>
                                    <span>@o.Probability%</span>
                                </div>
                            </td>
                            <td class="fw-semibold text-success">@o.WeightedPipeline.ToString("C0")</td>
                            <td>
                                <span class="@(o.ExpectedCloseDate < DateTime.UtcNow && o.Stage != "Won" && o.Stage != "Lost" ? "text-danger fw-bold" : "text-muted")">
                                    @o.ExpectedCloseDate.ToString("MMM dd, yyyy")
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-light text-secondary border">
                                    @(o.AssignedUser?.FullName ?? "Unassigned")
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@o.OpportunityId" class="btn btn-outline-secondary" title="View Details">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@o.OpportunityId" class="btn btn-outline-primary" title="Edit Deal">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>
                                    <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteOppModal-@o.OpportunityId" title="Delete Deal">
                                        <i class="fa-solid fa-trash-can"></i>
                                    </button>
                                </div>

                                <!-- Delete Modal -->
                                <div class="modal fade text-start" id="deleteOppModal-@o.OpportunityId" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title fw-bold text-danger">Confirm Delete</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body">
                                                Are you sure you want to delete opportunity <strong>@o.OpportunityName</strong>?
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                                <form asp-action="Delete" asp-route-id="@o.OpportunityId" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-danger">Delete</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-handshake-slash fs-2 mb-2 d-block text-secondary"></i>
                            No opportunities found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (ViewBag.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
            <span class="small text-muted">Page @ViewBag.CurrentPage of @ViewBag.TotalPages</span>
            <ul class="pagination pagination-sm mb-0">
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" 
                           asp-route-page="@i" 
                           asp-route-search="@ViewBag.CurrentSearch" 
                           asp-route-stage="@ViewBag.CurrentStage" 
                           asp-route-status="@ViewBag.CurrentStatus">@i</a>
                    </li>
                }
            </ul>
        </div>
    }
</div>
